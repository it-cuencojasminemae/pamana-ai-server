HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Prototype data mode. Keep true until route, vehicle, occupancy, and
# prediction inputs have verified operational provenance.
DEMO_MODE=true

# Server-only Geoapify key used for walking access and egress routing.
# Keep this separate from any browser key and restrict it by server IP where practical.
# Missing configuration leaves Strapi available and disables walking routing only.
GEOAPIFY_SERVER_API_KEY=

# --- AI workstream (Phase 17 provider infrastructure) ---
# Selects which provider getAIExplainProvider() returns: "openai" or "gemini".
AI_PROVIDER=gemini
# OpenAI key (https://platform.openai.com/api-keys). Leave blank if unused.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini in code if left blank.
OPENAI_MODEL=
# Gemini key (https://aistudio.google.com/apikey). Leave blank if unused.
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash in code if left blank. Google's free-tier
# model list changes periodically - see https://ai.google.dev/gemini-api/docs/models
# if requests start failing with a model-not-found error.
GEMINI_MODEL=
