HOST=0.0.0.0
PORT=1337
# Set the backend's public HTTPS origin at build time and runtime on any host.
PUBLIC_URL=
IS_PROXIED=true
MAX_IPS_COUNT=1
# Local development values only. Hosted PostgreSQL may use DATABASE_URL or
# explicit connection variables. See the deployment guide for verified TLS.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Defaults preserve local development. Distinct frontend/backend sites require
# SESSION_COOKIE_SAME_SITE=none and SESSION_COOKIE_SECURE=true over HTTPS.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# Add the computer's LAN origin while testing from a phone, for example
# http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.13:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Prototype data mode. Keep true until route, vehicle, occupancy, and
# prediction inputs have verified operational provenance.
DEMO_MODE=true

# Separate, server-owned gate for the nonpersistent Phase 16 live-vehicle
# simulator. Client request bodies cannot enable it. Disabled by default.
PAMANA_DEMO_MODE_ENABLED=false

# Server-only Geoapify key used for walking access and egress routing.
# Keep this separate from any browser key and restrict it by server IP where practical.
# Missing configuration leaves Strapi available and disables walking routing only.
GEOAPIFY_SERVER_API_KEY=

# Independent rollout gates. Enable pins only with a verified boundary;
# travel times are approximate road proxies, never a live jeepney arrival ETA.
PAMANA_MAP_PINS_ENABLED=false
PAMANA_TRAVEL_TIME_ENABLED=false
# Optional sanitized status/latency logs. No passenger coordinates or provider URLs.
PAMANA_TRAVEL_TIME_LOG_METRICS=false

# Independent curated-landmark and verified outbound-route gates.
PAMANA_PILOT_LANDMARKS_ENABLED=false
PAMANA_CSF_ROUTE_EXPANSION_ENABLED=false
PAMANA_RESEARCH_PREVIEW_ENABLED=false
PAMANA_RESEARCH_SIMULATED_OBSERVATIONS_ENABLED=false
PAMANA_CSF_MAP_PINS_ENABLED=false
PREFERRED_WALK_TO_TRANSIT_METERS=500
MAX_WALK_TO_TRANSIT_METERS=1500
# Sanitized planning status, latency, option count and transfer-walk failures only.
PAMANA_CSF_LOG_METRICS=false

# --- AI workstream (Phase 17 provider infrastructure) ---
# Server-owned selection for both explanation paths: "openai" or "gemini".
# PAMANA production uses OpenAI; Gemini remains an explicit alternative.
# No automatic provider fallback is performed.
AI_PROVIDER=openai
# Server-only OpenAI key for the optional Phase 20 journey explanation. Never expose it to Nuxt.
# Leave blank to keep deterministic trip planning available with explanation status NOT_CONFIGURED.
OPENAI_API_KEY=
# Stable Phase 20 default; change only after validating a replacement model.
OPENAI_MODEL=gpt-4o-mini
# Gemini key (https://aistudio.google.com/apikey). Leave blank if unused.
GEMINI_API_KEY=
# Defaults to the stable gemini-3.6-flash model in code if left blank.
GEMINI_MODEL=gemini-3.6-flash

# Manual availability expiry, seconds. Initial assumption; validate operationally.
MANUAL_AVAILABILITY_MAX_AGE_SECONDS=900

# Optional server-only TomTom road-traffic overlay. Never expose this key in Nuxt.
# Missing key keeps traffic unavailable; the Trip Planner and basemap still work.
TOMTOM_API_KEY=
# Set false to disable traffic even when a key is present. UI remains opt-in.
PAMANA_TRAFFIC_ENABLED=true
