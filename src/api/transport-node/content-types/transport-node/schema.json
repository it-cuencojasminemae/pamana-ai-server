{
  "kind": "collectionType",
  "collectionName": "transport_nodes",
  "info": {
    "singularName": "transport-node",
    "pluralName": "transport-nodes",
    "displayName": "Transport Node"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "node_code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "latitude": {
      "type": "decimal",
      "min": -90,
      "max": 90
    },
    "longitude": {
      "type": "decimal",
      "min": -180,
      "max": 180
    },
    "node_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "ROADSIDE_PICKUP",
        "DESIGNATED_STOP",
        "TERMINAL",
        "LOADING_BAY",
        "DROP_OFF",
        "TRANSFER_POINT",
        "TRANSPORT_HUB",
        "LANDMARK",
        "DESTINATION",
        "ESSENTIAL_SERVICE",
        "EMERGENCY_PICKUP"
      ]
    },
    "barangay": {
      "type": "string"
    },
    "municipality_city": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "google_place_id": {
      "type": "string"
    },
    "covered_waiting_area": {
      "type": "boolean"
    },
    "wheelchair_accessible": {
      "type": "boolean"
    },
    "lighting_notes": {
      "type": "text"
    },
    "safety_notes": {
      "type": "text"
    },
    "accessibility_notes": {
      "type": "text"
    },
    "planning_enabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "verification_status": {
      "type": "enumeration",
      "required": true,
      "default": "RESEARCH_CANDIDATE",
      "enum": [
        "AUTHORITATIVE_CURRENT",
        "FIELD_VERIFIED",
        "CORROBORATED_RESEARCH",
        "HISTORICAL_UNVERIFIED",
        "SIMULATED_DEMO",
        "RESEARCH_CANDIDATE"
      ]
    },
    "data_mode": {
      "type": "enumeration",
      "required": true,
      "default": "REAL",
      "enum": [
        "REAL",
        "SIMULATED"
      ]
    },
    "verified_at": {
      "type": "datetime"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "text"
    },
    "source_reference": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    },
    "starting_variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::route-variant.route-variant",
      "mappedBy": "start_node"
    },
    "ending_variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::route-variant.route-variant",
      "mappedBy": "end_node"
    },
    "route_variant_stops": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::route-variant-stop.route-variant-stop",
      "mappedBy": "transport_node"
    }
  }
}
