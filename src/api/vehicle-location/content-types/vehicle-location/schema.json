{
  "kind": "collectionType",
  "collectionName": "vehicle_locations",
  "info": {
    "singularName": "vehicle-location",
    "pluralName": "vehicle-locations",
    "displayName": "Vehicle Location"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "latitude": {
      "type": "float",
      "required": true
    },
    "longitude": {
      "type": "float",
      "required": true
    },
    "speed": {
      "type": "decimal"
    },
    "heading": {
      "type": "decimal"
    },
    "recorded_at": {
      "type": "datetime",
      "required": true
    },
    "data_mode": {
      "type": "enumeration",
      "required": true,
      "default": "SIMULATED",
      "enum": [
        "REAL",
        "SIMULATED"
      ]
    },
    "vehicle": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vehicle.vehicle",
      "required": true,
      "inversedBy": "vehicle_locations"
    },
    "trip": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::trip.trip",
      "required": true,
      "inversedBy": "vehicle_locations"
    }
  }
}
