{
  "kind": "collectionType",
  "collectionName": "fare_rules",
  "info": {
    "singularName": "fare-rule",
    "pluralName": "fare-rules",
    "displayName": "Fare Rule"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "route": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route.route",
      "inversedBy": "fare_rules"
    },
    "route_variant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route-variant.route-variant",
      "inversedBy": "fare_rules"
    },
    "fare_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "FLAT",
        "DISTANCE_BASED",
        "ZONE",
        "MANUAL_LOOKUP"
      ]
    },
    "currency": {
      "type": "string",
      "required": true,
      "default": "PHP",
      "maxLength": 3
    },
    "regular_base_fare": {
      "type": "decimal",
      "min": 0
    },
    "base_distance_km": {
      "type": "decimal",
      "min": 0
    },
    "per_km_after_base": {
      "type": "decimal",
      "min": 0
    },
    "minimum_fare": {
      "type": "decimal",
      "min": 0
    },
    "rounding_rule": {
      "type": "string"
    },
    "student_discount_percent": {
      "type": "decimal",
      "min": 0,
      "max": 100
    },
    "senior_discount_percent": {
      "type": "decimal",
      "min": 0,
      "max": 100
    },
    "pwd_discount_percent": {
      "type": "decimal",
      "min": 0,
      "max": 100
    },
    "effective_from": {
      "type": "date"
    },
    "effective_to": {
      "type": "date"
    },
    "planning_enabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "verification_status": {
      "type": "enumeration",
      "required": true,
      "default": "RESEARCH_CANDIDATE",
      "enum": [
        "AUTHORITATIVE_CURRENT",
        "FIELD_VERIFIED",
        "CORROBORATED_RESEARCH",
        "HISTORICAL_UNVERIFIED",
        "SIMULATED_DEMO",
        "RESEARCH_CANDIDATE"
      ]
    },
    "data_mode": {
      "type": "enumeration",
      "required": true,
      "default": "REAL",
      "enum": [
        "REAL",
        "SIMULATED"
      ]
    },
    "verified_at": {
      "type": "datetime"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "text"
    },
    "source_reference": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    }
  }
}
