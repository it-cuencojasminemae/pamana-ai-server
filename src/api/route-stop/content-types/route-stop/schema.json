{
  "kind": "collectionType",
  "collectionName": "route_stops",
  "info": {
    "singularName": "route-stop",
    "pluralName": "route-stops",
    "displayName": "Route Stop"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "sequence": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "latitude": {
      "type": "float",
      "required": true
    },
    "longitude": {
      "type": "float",
      "required": true
    },
    "stop_type": {
      "type": "enumeration",
      "enum": [
        "pickup",
        "dropoff",
        "both",
        "terminal"
      ]
    },
    "covered_waiting_area": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "accessible_toilet_nearby": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "planning_enabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "verification_status": {
      "type": "enumeration",
      "required": true,
      "default": "RESEARCH_CANDIDATE",
      "enum": [
        "AUTHORITATIVE_CURRENT",
        "FIELD_VERIFIED",
        "CORROBORATED_RESEARCH",
        "HISTORICAL_UNVERIFIED",
        "SIMULATED_DEMO",
        "RESEARCH_CANDIDATE"
      ]
    },
    "data_mode": {
      "type": "enumeration",
      "required": true,
      "default": "REAL",
      "enum": [
        "REAL",
        "SIMULATED"
      ]
    },
    "verified_at": {
      "type": "datetime"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "text"
    },
    "source_reference": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    },
    "route": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route.route",
      "inversedBy": "route_stops"
    },
    "passenger_reports": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::passenger-report.passenger-report",
      "mappedBy": "stop"
    },
    "passenger_demand_observations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::passenger-demand-observation.passenger-demand-observation",
      "mappedBy": "stop"
    },
    "predictions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::prediction.prediction",
      "mappedBy": "stop"
    }
  }
}
