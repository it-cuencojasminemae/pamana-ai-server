{
  "kind": "collectionType",
  "collectionName": "passenger_reports",
  "info": {
    "singularName": "passenger-report",
    "pluralName": "passenger-reports",
    "displayName": "Passenger Report"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "report_type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "vehicle_arrived",
        "vehicle_full",
        "seats_available",
        "route_unavailable",
        "flood",
        "vehicle_breakdown",
        "VEHICLE_FULL",
        "LONG_WAIT",
        "NO_SERVICE_OBSERVED",
        "STOP_ISSUE",
        "ROUTE_INFORMATION_ISSUE",
        "ACCESSIBILITY_ISSUE",
        "DISRUPTION",
        "OTHER"
      ]
    },
    "description": {
      "type": "text"
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "location_note": {
      "type": "string"
    },
    "location_accuracy_m": {
      "type": "float",
      "min": 0
    },
    "reported_at": {
      "type": "datetime",
      "required": true
    },
    "data_mode": {
      "type": "enumeration",
      "required": true,
      "default": "SIMULATED",
      "enum": [
        "REAL",
        "SIMULATED"
      ]
    },
    "review_status": {
      "type": "enumeration",
      "required": true,
      "default": "PENDING",
      "enum": [
        "PENDING",
        "REVIEWED",
        "VERIFIED",
        "DISMISSED"
      ]
    },
    "reviewed_at": {
      "type": "datetime"
    },
    "review_notes": {
      "type": "text"
    },
    "context_source": {
      "type": "enumeration",
      "required": true,
      "default": "NONE",
      "enum": [
        "NONE",
        "SELECTED_JOURNEY",
        "VISIBLE_NODE",
        "ACTIVE_TRIP"
      ]
    },
    "passenger": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::passenger-profile.passenger-profile",
      "inversedBy": "passenger_reports"
    },
    "route": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route.route",
      "inversedBy": "passenger_reports"
    },
    "route_variant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route-variant.route-variant"
    },
    "transport_node": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::transport-node.transport-node"
    },
    "stop": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route-stop.route-stop",
      "inversedBy": "passenger_reports"
    },
    "vehicle": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vehicle.vehicle",
      "inversedBy": "passenger_reports"
    },
    "trip": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::trip.trip"
    }
  }
}
