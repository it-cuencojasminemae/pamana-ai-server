{
  "kind": "collectionType",
  "collectionName": "disruptions",
  "info": {
    "singularName": "disruption",
    "pluralName": "disruptions",
    "displayName": "Disruption"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "flood",
        "road_closure",
        "accident",
        "weather",
        "route_suspension",
        "breakdown"
      ]
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    },
    "severity": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "starts_at": {
      "type": "datetime",
      "required": true
    },
    "ends_at": {
      "type": "datetime"
    },
    "disruption_status": {
      "type": "enumeration",
      "required": true,
      "default": "active",
      "enum": [
        "active",
        "resolved",
        "inactive"
      ]
    },
    "source": {
      "type": "string",
      "required": true
    },
    "effect": {
      "type": "enumeration",
      "enum": [
        "WARNING_ONLY",
        "LIMITED_SERVICE",
        "ROUTE_SUSPENDED",
        "VARIANT_SUSPENDED",
        "NODE_CLOSED",
        "BOARDING_CLOSED",
        "ALIGHTING_CLOSED",
        "TRANSFER_BLOCKED"
      ]
    },
    "affected_route": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route.route"
    },
    "affected_route_variant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::route-variant.route-variant"
    },
    "affected_transport_node": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::transport-node.transport-node"
    },
    "planning_enabled": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "verification_status": {
      "type": "enumeration",
      "required": true,
      "default": "RESEARCH_CANDIDATE",
      "enum": [
        "AUTHORITATIVE_CURRENT",
        "FIELD_VERIFIED",
        "CORROBORATED_RESEARCH",
        "HISTORICAL_UNVERIFIED",
        "SIMULATED_DEMO",
        "RESEARCH_CANDIDATE"
      ]
    },
    "data_mode": {
      "type": "enumeration",
      "required": true,
      "default": "SIMULATED",
      "enum": [
        "REAL",
        "SIMULATED"
      ]
    },
    "verified_at": {
      "type": "datetime"
    },
    "source_name": {
      "type": "string"
    },
    "source_url": {
      "type": "text"
    },
    "source_reference": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    },
    "resolved_at": {
      "type": "datetime"
    },
    "resolution_notes": {
      "type": "text"
    },
    "geometry_source": {
      "type": "enumeration",
      "required": true,
      "default": "UNKNOWN",
      "enum": [
        "FIELD_GPS",
        "AUTHORITATIVE",
        "GOOGLE_ROAD_MATCHED",
        "MANUAL_VERIFIED",
        "SIMULATED",
        "UNKNOWN"
      ]
    },
    "geometry_geojson": {
      "type": "json"
    }
  }
}
